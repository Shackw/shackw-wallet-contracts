{
  "compilerOptions": {
    "target": "es2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "hardhat.config.ts", "scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "cache",
    "artifacts",
    "typechain",
    "typechain-types"
  ]
}
