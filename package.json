{
  "name": "shackw-wallet-contracts",
  "version": "0.0.1",
  "description": "Smart contract implementation of a JPYC Token Paymaster for ShackwWallet using ERC-4337 Account Abstraction.",
  "license": "ISC",
  "author": "Shackw",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "clean": "rm -rf cache artifacts typechain typechain-types",
    "tsc": "tsc",
    "lint": "yarn lint:sol && yarn lint:js",
    "lint:js": "eslint -f unix . --fix",
    "lint:sol": "solhint -f unix \"contracts/**/*.sol\" --max-warnings 0",
    "format": "prettier . --write",
    "deploy-eip7702:main": "yarn clean && hardhat run --network main src/entry/eip7702.ts",
    "deploy-eip7702:sepolia": "yarn clean && hardhat run --network sepolia src/entry/eip7702.ts",
    "deploy-eip7702:base": "yarn clean && hardhat run --network base src/entry/eip7702.ts",
    "deploy-eip7702:baseSepolia": "yarn clean && hardhat run --network baseSepolia src/entry/eip7702.ts",
    "deploy-eip7702:polygon": "yarn clean && hardhat run --network polygon src/entry/eip7702.ts",
    "deploy-eip7702:polygonAmoy": "yarn clean && hardhat run --network polygonAmoy src/entry/eip7702.ts",
    "generate:signer": "node ./scripts/generateSigner.mjs"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-solidity"
    ]
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.3",
    "@nomicfoundation/hardhat-ignition": "^3.0.5",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.2",
    "@nomicfoundation/hardhat-verify": "^3.0.6",
    "@nomicfoundation/ignition-core": "^3.0.5",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "chai": "^6.2.1",
    "dotenv-flow": "^4.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "hardhat": "^3.0.13",
    "hardhat-gas-reporter": "^2.3.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.2.0",
    "solhint": "^6.0.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.15.0",
    "pino": "^10.1.0",
    "valibot": "^1.1.0"
  }
}
