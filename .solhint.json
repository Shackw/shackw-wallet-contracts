{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", ">=0.7.5"],
    "func-visibility": ["off", { "ignoreConstructors": true }],
    "explicit-types": ["warn", "explicit"],
    "no-global-import": "off",
    "immutable-vars-naming": "off",
    "avoid-tx-origin": "off",
    "no-empty-blocks": "off",
    "reason-string": "off",
    "var-name-mixedcase": "off"
  }
}
